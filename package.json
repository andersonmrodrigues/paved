{
  "name": "paved-core",
  "version": "1.9.0",
  "description": "An agent-first, verifiable engineering framework for software repositories.",
  "license": "MIT",
  "author": "Anderson Rodrigues",
  "homepage": "https://github.com/andersonmrodrigues/paved#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/andersonmrodrigues/paved.git"
  },
  "bugs": {
    "url": "https://github.com/andersonmrodrigues/paved/issues"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "engineering",
    "verification",
    "workflow"
  ],
  "type": "module",
  "bin": {
    "paved": "./cli/build/cli/index.js"
  },
  "files": [
    "adapters/",
    "cli/",
    "core/",
    "generators/",
    "integrations/",
    "schemas/",
    "manifest.yaml",
    "VERSION",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "paved": "node ./cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:plugin": "node plugins/build.ts",
    "check:plugin": "node plugins/build.ts --check",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "markdown-it": "14.3.2",
    "yaml": "2.9.1"
  },
  "bundleDependencies": [
    "ajv",
    "markdown-it",
    "yaml"
  ],
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  }
}
